# ---------------------------------------------------------------------------
# Cheapest Fuel Finder — environment variables
# Copy this file to .env (local dev) and configure the same keys in your
# hosting provider's dashboard (e.g. Vercel > Project > Settings > Environment
# Variables) for production. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- NSW FuelCheck API -------------------------------------------------
# Register a free account at https://api.nsw.gov.au (Product: "Fuel API"),
# create an application, and generate a consumer key/secret pair.
# Free tier: 2,500 calls/month. Keep these server-side ONLY — they are read
# by the /api serverless functions and must never reach the browser.
NSW_FUELCHECK_API_KEY=your_consumer_key_here
NSW_FUELCHECK_API_SECRET=your_consumer_secret_here

# --- OpenRouteService (routing / driving distance) ----------------------
# Free account at https://account.heigit.org — free tier includes 2,000
# directions requests/day and 2,500 matrix requests/day.
ORS_API_KEY=your_openrouteservice_key_here

# --- Nominatim (OpenStreetMap geocoding) ---------------------------------
# No key required, but the usage policy requires a descriptive User-Agent
# identifying the application. Set a contact email so OSM can reach you if
# there's ever a usage concern.
NOMINATIM_USER_AGENT=cheapest-fuel-finder (contact@example.com)
